    "fritzwgConnectedState": {
      "type": "text",
      "label": "fritzwgConnectedState_label",
      "help": "fritzwgConnectedState_help",
      "placeholder": "fritzwgConnectedState_placeholder",
      "default": "",
      "sm": 8,
      "hidden": "data.networkMode !== 'fritzwireguard'",
      "xs": 12,
      "md": 8,
      "lg": 8,
      "xl": 8
